{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "endOfLine": "lf",
  "singleQuote": false,
  "jsxSingleQuote": false,
  "semi": true,
  "trailingComma": "es5",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "quoteProps": "as-needed",
  "sortImports": false,
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "bun.lock",
    "vercel.json",
    "**/*.md",
    "**/*.mdx",
    "**/_generated/",
    "**/*.gen.*",
    "**/.next/",
    "**/next-env.d.ts",
    "**/.nuxt/",
    "**/.output/",
    "**/.svelte-kit/",
    "**/.vitepress/cache/",
    "**/.vitepress/dist/",
    "**/dist/",
    "**/build/",
    "**/out/",
    "**/.turbo/",
    "**/.vercel/",
    "**/.netlify/",
    "**/storybook-static/",
    "**/.docusaurus/",
    "**/.cache/",
    "**/.parcel-cache/",
    "**/.vite/",
    "**/.astro/",
    "**/_astro/",
    "**/coverage/",
    "**/.nyc_output/",
    "**/*.generated.*",
    "**/*.auto.*",
    "**/generated/",
    "**/auto-generated/",
    "**/codegen/",
    "**/__generated__/",
    "**/graphql-types.*",
    "**/schema.d.ts",
    "**/schema.graphql.d.ts",
    "**/*.d.ts.map",
    "**/.expo/",
    "**/.expo-shared/",
    "**/DerivedData/",
    "**/*.min.js",
    "**/*.min.css",
    "**/worker-configuration.d.ts",
    ".env",
    ".env.*"
  ],
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc"],
      "options": { "trailingComma": "none" }
    }
  ]
}
