{
  "name": "kleis",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "bun run --hot --no-clear-screen src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist --packages=external",
    "start": "bun run src/index.ts",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxfmt --check && oxlint",
    "fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.2",
    "ws": "8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/ws": "8.18.1",
    "@typescript/native-preview": "^7.0.0-dev.20260223.1",
    "drizzle-kit": "^0.31.9",
    "happy-dom": "^21.0.1",
    "lefthook": "^2.1.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0"
  }
}
